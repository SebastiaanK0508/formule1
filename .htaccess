# F1SITE.NL — Apache configuration

Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

# Block configuration files and non-public file types (works without mod_rewrite)
<FilesMatch "^(config\.local\.php|config\.example\.php|.*\.(sql|md|log|sh|py))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Dynamic XML sitemap
    RewriteRule ^sitemap\.xml$ sitemap-xml.php [L]
    # Never serve internal code, configuration, data or cache over HTTP
    RewriteRule ^(includes|scripts|storage|data|database)(/|$) - [F,L]
    RewriteRule ^config(\.local|\.example)?\.php$ - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(sql|md|log|sh|json)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/calendar
</IfModule>
